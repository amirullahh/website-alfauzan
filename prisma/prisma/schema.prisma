generator client {
  provider = "prisma-client-js"
}

// Untuk production, uncomment blok postgresql dan comment blok sqlite:
// datasource db {
//   provider  = "postgresql"
//   url       = env("DATABASE_URL")
//   directUrl = env("DIRECT_URL")
// }

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String      @id @default(cuid())
  email         String      @unique
  password      String
  name          String
  role          UserRole    @default(SANTRI)
  accessLevel   AccessLevel?
  nis           String?     @unique
  nip           String?     @unique
  phone         String?
  photoUrl      String?
  jabatan          String?
  teacherProfileId String?
  teacherProfile   Teacher?   @relation(fields: [teacherProfileId], references: [id])
  statusAkun       StatusAkun  @default(AKTIF)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  attendanceRecords AttendanceRecord[]
  izinSakit         IzinSakit[]  @relation("IzinSakitUser")
  izinSakitDibuat   IzinSakit[]  @relation("IzinSakitCreator")
  auditLogs         AuditLog[]   @relation("AuditActor")

  @@map("users")
}

model Location {
  id          String   @id @default(cuid())
  name        String
  latitude    Float
  longitude   Float
  radiusMeter Int      @default(100)
  isActive    Boolean  @default(true)
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sessions AttendanceSession[]

  @@map("locations")
}

model AttendanceSession {
  id                  String   @id @default(cuid())
  name                String
  jamMulai            String
  jamSelesai          String
  batasToleransiMenit Int      @default(15)
  locationId          String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  location  Location?          @relation(fields: [locationId], references: [id])
  records   AttendanceRecord[]

  @@map("attendance_sessions")
}

model AttendanceRecord {
  id              String           @id @default(cuid())
  userId          String
  sessionId       String
  tanggal         String
  jamMasuk        String?
  fotoMasukUrl    String?
  lokasiMasukLat  Float?
  lokasiMasukLng  Float?
  lokasiMasukAkurasi Float?
  lokasiMasukJarak Float?
  jamPulang       String?
  fotoPulangUrl   String?
  lokasiPulangLat Float?
  lokasiPulangLng Float?
  status          AttendanceStatus @default(ALPA)
  syncedAt        DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  session AttendanceSession @relation(fields: [sessionId], references: [id])

  @@unique([userId, sessionId, tanggal])
  @@map("attendance_records")
}

enum UserRole {
  SANTRI
  USTADZ
  PENGURUS
}

enum AccessLevel {
  SUPER_ADMIN
  PENGURUS
}

enum IzinSakitJenis {
  IZIN
  SAKIT
}

model IzinSakit {
  id           String         @id @default(cuid())
  userId       String
  tanggalMulai String
  tanggalSelesai String?
  jenis        IzinSakitJenis
  keterangan   String?
  createdById  String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user      User @relation("IzinSakitUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User @relation("IzinSakitCreator", fields: [createdById], references: [id])

  @@map("izin_sakit")
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  aksi      String
  entitas   String
  entitasId String?
  detail    String?
  createdAt DateTime @default(now())

  actor User @relation("AuditActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@map("audit_logs")
}

model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

enum StatusAkun {
  AKTIF
  NONAKTIF
  SUSPENDED
}

enum AttendanceStatus {
  HADIR
  TERLAMBAT
  IZIN
  SAKIT
  ALPA
}

model News {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String?
  content     String
  coverUrl    String?
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  @@index([isPublished, publishedAt])
}

model Agenda {
  id          String   @id @default(cuid())
  title       String
  description String?
  location    String?
  startDate   DateTime
  endDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([startDate])
}

model Achievement {
  id        String   @id @default(cuid())
  title     String
  category  String?
  level     String?
  year      Int
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([year])
}

model Program {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  iconUrl     String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Facility {
  id          String   @id @default(cuid())
  name        String
  description String?
  imageUrl    String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Extracurricular {
  id          String   @id @default(cuid())
  name        String
  description String?
  imageUrl    String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Teacher {
  id        String   @id @default(cuid())
  name      String
  role      String?
  photoUrl  String?
  bio       String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
}

model GalleryItem {
  id        String   @id @default(cuid())
  album     String?
  imageUrl  String
  caption   String?
  createdAt DateTime @default(now())
  @@index([album])
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PsbSubmission {
  id          String   @id @default(cuid())
  studentName String
  studentDob  DateTime?
  parentName  String
  phone       String
  email       String?
  address     String?
  notes       String?
  status      PsbStatus @default(BARU)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  @@index([status, createdAt])
}

enum PsbStatus {
  BARU
  DIPROSES
  SELESAI
  DITOLAK
}
