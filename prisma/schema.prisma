// Prisma schema — Website Pondok Pesantren Al Fauzan Nusantara
// Lihat ARCHITECTURE.md untuk penjelasan tiap model & alasan desainnya.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled connection (Supabase transaction pooler, port 6543)
  directUrl = env("DIRECT_URL")   // direct connection, dipakai khusus saat `prisma migrate`
}

// ===================== CONTENT MODELS =====================

model News {
  id          String    @id @default(cuid())
  title       String
  slug        String    @unique
  excerpt     String?
  content     String
  coverUrl    String?
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isPublished, publishedAt])
}

model Agenda {
  id          String   @id @default(cuid())
  title       String
  description String?
  location    String?
  startDate   DateTime
  endDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([startDate])
}

model Achievement {
  id        String   @id @default(cuid())
  title     String
  category  String?
  level     String?  // sekolah | kota | provinsi | nasional | internasional
  year      Int
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([year])
}

model Program {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  iconUrl     String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Facility {
  id          String   @id @default(cuid())
  name        String
  description String?
  imageUrl    String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Extracurricular {
  id          String   @id @default(cuid())
  name        String
  description String?
  imageUrl    String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Teacher {
  id        String   @id @default(cuid())
  name      String
  role      String?  // jabatan/mapel
  photoUrl  String?
  bio       String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GalleryItem {
  id        String   @id @default(cuid())
  album     String?
  imageUrl  String
  caption   String?
  createdAt DateTime @default(now())

  @@index([album])
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ===================== PSB (PENDAFTARAN) =====================

model PsbSubmission {
  id          String   @id @default(cuid())
  studentName String
  studentDob  DateTime?
  parentName  String
  phone       String
  email       String?
  address     String?
  notes       String?
  status      PsbStatus @default(BARU)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, createdAt])
}

enum PsbStatus {
  BARU
  DIPROSES
  SELESAI
  DITOLAK
}

// ===================== AUTH (ADMIN ONLY) =====================

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
